	<string>写真を撮影し、現在の視界に対応する過去の写真を見つけるためにカメラを使用します。</string>
	<key>WBCloudVerificationToken</key>
	<string>$(WB_CLOUD_VERIFICATION_TOKEN)</string>
	<key>WBCloudVerificationURL</key>
	<string>$(WB_CLOUD_VERIFICATION_URL)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>

